#!/usr/bin/env bash
# Apre un file markdown con glow in un pane herdr a destra (superfile: [open_with] md = "herdr-glow").
# superfile avvia open_with staccato dal terminale, quindi una TUI serve in un pane separato.
set -euo pipefail

file=$1

if [[ -z ${HERDR_PANE_ID:-} ]]; then
	exec xdg-open "$file"
fi

pane=$(herdr pane split --current --direction right --focus | jq -r '.result.pane.pane_id')
# && exit: se glow fallisce, il pane resta aperto e mostra l'errore
herdr pane run "$pane" "glow -t $(printf '%q' "$file") && exit"
