#!/usr/bin/env bash
# zj-radar-mirror: copia i file di presenza di zj-radar dalla VPS nella cache
# locale del plugin, così la rail locale mostra le sessioni della VPS come peer
# "<attach_host>/<nome>" e un click apre un pane `ssh -t <attach_host> zellij attach <nome>`.
# L'mtime remoto viene conservato: una sessione VPS chiusa invecchia e sparisce
# dalla rail (stale dopo 90 s, rimossa dopo 300 s) come un peer locale. Un file con
# mtime invariato non viene ricopiato: ✕ e la rimozione dei morti restano validi.
set -u
host=infomaniak-radar   # chiave dedicata, command= forzato: zj-radar-presence-dump
attach_host=infomaniak  # alias ssh interattivo che il click della rail usa per l'attach
prefix=vps              # suffisso del nome file locale: mai in collisione con un pid locale
local_dir="$HOME/.cache/zellij/file:$HOME/.config/zellij/plugins/zj_radar.wasm/plugin_cache"
ctl="${XDG_RUNTIME_DIR:-/tmp}/zj-radar-mirror.ssh"
declare -A seen   # file remoto -> mtime già gestito (copiato, oppure scartato perché morto)
while :; do
  out=$(ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 \
      -o ControlMaster=auto -o ControlPath="$ctl" -o ControlPersist=120 "$host" \
      zj-radar-presence-dump 2>/dev/null)
  if (( $? == 255 )); then sleep 10; continue; fi   # VPS non raggiungibile: non dimenticare niente
  now=$(date +%s)
  declare -A listed=()
  copied=0
  while IFS=$'\t' read -r name mtime json; do
    [[ -n $name ]] || continue
    listed[$name]=1
    # mtime invariato: non rimettere un file che la rail ha tolto (✕ o sessione morta)
    [[ ${seen[$name]-} == "$mtime" ]] && continue
    seen[$name]=$mtime
    (( now - mtime < 300 )) || continue   # già morto: la rail lo toglierebbe subito
    tmp="$local_dir/$name.mirror.tmp"   # non termina in .json: nessuna rail lo legge
    printf '%s' "$json" | sed "s|^{|{\"host\":\"$attach_host\",|" > "$tmp" &&
      touch -d "@$mtime" "$tmp" &&
      mv -f "$tmp" "$local_dir/${name/presence./presence.$prefix-}" &&
      copied=1
  done <<< "$out"
  for k in "${!seen[@]}"; do [[ -v listed[$k] ]] || unset 'seen[$k]'; done
  # le rail leggono le presenze solo al loro giro (fino a un minuto se ferme):
  # dopo una copia avvisa ogni sessione locale, che le rilegge subito
  if (( copied )); then
    while read -r s; do
      timeout 5 zellij --session "$s" pipe --name zj_radar.cmd.v1 -- session-refresh >/dev/null 2>&1 &
    done < <(zellij list-sessions --short --no-formatting 2>/dev/null)
  fi
  # ogni 2 s: età locale = intervallo di scrittura remoto (≤ 75 s) + ritardo di copia, sotto i 90 s di "fresh"
  sleep 2
done
