# Pry.config.editor = proc { |file, line| "gvim --servername GVIM --remote-tab-wait-silent +#{line} #{file}" }
Pry.config.editor = proc { |file, line| "vim +#{line} #{file}" }

# Il pager esterno (less/more) blocca il prompt su WezTerm + ConPTY
# (stessa race documentata in .irbrc) => output diretto senza pager.
Pry.config.pager = false

Pry.config.history_file = "#{ENV['HOME']}/.pry_history"

Pry.config.prompt_name = "#{File.basename(Dir.pwd)}"
Pry.config.prompt = Pry::Prompt.new(
  "sphynx",
  "Prompt con contatore input, nome directory e contesto",
  [
    proc { |target_self, nest_level, pry|
      prompt = "[#{pry.input_ring.size}]"
      prompt += " #{Pry.config.prompt_name}"
      prompt += "(#{Pry.view_clip(target_self)})"
      prompt += "#{":#{nest_level}" unless nest_level.zero?}> "
      prompt
    },
    proc { |target_self, nest_level, pry|
      prompt = "[#{pry.input_ring.size}]"
      prompt += " #{Pry.config.prompt_name}"
      prompt += "(#{Pry.view_clip(target_self)})"
      prompt += "#{":#{nest_level}" unless nest_level.zero?}"
      prompt = ([' '] * prompt.length).join('')
      prompt = prompt[0...-(pry.input_ring.size.to_s.length + 2)]
      prompt += " #{pry.input_ring.size} "
      prompt += "> "
      prompt
    },
  ]
)

cmd_aliases = {
  'continue' => 'c',
  'step' => 's',
  'next' => 'n',
  'whereami' => 'w',
  'whereami -m' => 'wm',
  'whereami -c' => 'wc',
  'copy-history' => 'ch',
  'copy-result' => 'cr',
}
cmd_aliases.each do |_cmd, _alias|
  Pry.commands.alias_command _alias, _cmd if Pry.commands[_cmd]
end

# per eseguire 3 righe devo dare "play -l 3"
# con il codice seguente ora posso dare "pl 3" oppure "pl 3..5"
Pry::Commands.block_command 'pl', "Alias for 'play -l'" do |lines|
  run "play -l #{lines}"
end

Pry.config.color = true
Pry.config.auto_indent = true
Pry.config.correct_indent = true

Pry.config.exception_handler = proc do |output, exception, _pry_|
  if SyntaxError === exception
    output.puts "SyntaxError: #{exception.message.sub(/.*syntax error, */m, '')}"
  else
    output.puts "#{exception.class}: #{exception.message}"
    output.print "From:\n"
    output.print exception.backtrace.join("\n")
    print "\n"
  end
end

