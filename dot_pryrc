# AMAZING_PRINT (fork mantenuto di awesome_print)
begin
  if ensure_gem('amazing_print')
    warn "  Desc: usato per avere un miglior output con ap"
    require 'amazing_print'
    AmazingPrint.pry!  # usa ap come formatter di default per i risultati
  end
rescue StandardError, LoadError
  show_exception('amazing_print')
end

# LOOKSEE
begin
  if ensure_gem('looksee')
    warn "  Desc: serve per avere la lista dei metodi per un oggetto"
    warn "     Command: Looksee.help          => mosta introduzione"
    warn "     Command: [].look               => mosta tutti i metodi"
    warn "     Command: [].look :noprivate    => mosta tutti i metodi ma non quelli privati"
    warn "     Command: [].look.edit :to_set  => mi apre vim su quel metodo"
    require 'looksee'
    Looksee.editor = "vim +%l %f"
  end
rescue StandardError, LoadError
  show_exception('looksee')
end

# HIRB
begin
  if ensure_gem('hirb')
    warn "  Desc: mi stampa in formato tabella i miei oggetti tipo array o hash o activerecord"
    warn "    Command: table mio_hash"
    require 'hirb'
    HIRB_LOADED = true
    extend Hirb::Console
    Hirb.enable({:width => 200, :height => 500, :formatter => false})
  end
rescue StandardError, LoadError
  show_exception('hirb')
  HIRB_LOADED = false
end

