puts "Loading #{__FILE__}..."

# Rende caricabile una gemma, installandola se davvero manca.
#
# Sotto Bundler il $LOAD_PATH è ristretto alle gemme del Gemfile: `gem <nome>`
# alza Gem::LoadError e il require fallisce anche quando la gemma è installata,
# quindi ogni avvio ritentava l'installazione a vuoto. Aggiungo a mano la lib
# della gemma e delle sue dipendenze, in coda al $LOAD_PATH così le versioni
# del bundle mantengono la precedenza.
def ensure_gem(gem_name)
  warn "Init Plugin: ==> #{gem_name}"
  return true if add_to_load_path(gem_name)

  warn "Gemma #{gem_name} non presente, procedo con l'installazione..."
  system("gem", "install", gem_name)
  Gem.refresh
  add_to_load_path(gem_name)
end

# Mette nel $LOAD_PATH la lib della gemma e delle sue dipendenze runtime.
# Restituisce false se la gemma non è installata.
def add_to_load_path(gem_name, seen = [])
  return true if seen.include?(gem_name)

  seen << gem_name
  path = gem_lib_path(gem_name)
  return false unless path

  $LOAD_PATH.push(path) unless $LOAD_PATH.include?(path)
  gem_dependencies(gem_name).each { |dep| add_to_load_path(dep, seen) }
  true
end

# Cartella lib della versione più alta della gemma installata, o nil se manca.
def gem_lib_path(gem_name)
  Gem.path
    .flat_map { |root| Dir["#{root}/gems/#{gem_name}-*/lib"] }
    .max_by { |path| Gem::Version.new(path[%r{-([^-/]+)/lib\z}, 1] || "0") }
end

# Nomi delle dipendenze runtime, lette dalla gemspec installata.
def gem_dependencies(gem_name)
  spec_file = Gem.path.flat_map { |root| Dir["#{root}/specifications/#{gem_name}-*.gemspec"] }.max
  spec_file ? Gem::Specification.load(spec_file).runtime_dependencies.map(&:name) : []
rescue StandardError, LoadError
  []
end

def show_exception(gem_name)
  warn "An error of type #{$!.class} happened, message is #{$!.message}"
  warn "Impossibile usare #{gem_name}, provare installare manualmente:"
  warn "  gem install #{gem_name}"
end

