    warn "  Desc: debugger: step / next / continue / break / up / down"
    require 'pry-byebug'
  end
rescue StandardError, LoadError
  show_exception('pry-byebug')
end

# PRY-CLIPBOARD
begin
  if ensure_gem('pry-clipboard')
    warn "  Desc: integrazione con la clipboard"
    warn "     Command:  copy-history -l              ==> copia history e risultati"
    warn "     Command:  copy-result                  ==> copia risultati"
    warn "     Command:  paste                        ==> incolla"
    warn "     Esempio:  history --tail 10            ==> mostra gli ultimi 10 comandi"
    warn "     Esempio:  copy-history 9               ==> copia il comando 9"
    warn "     Esempio:  copy-history --range 1..4    ==> copia un range"
    require 'pry-clipboard'
