{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Installa la sidebar zj-radar di zellij: wasm, alias e permessi.
# run_once: gira una volta per macchina; gli aggiornamenti dopo con `zj-radar update`.
# Alias e layout sono già nei template di chezmoi: qui serve soprattutto il wasm.
set -euo pipefail
if ! command -v zellij >/dev/null 2>&1; then
  echo "SALTATO: zellij non trovato, installalo e rilancia chezmoi apply" >&2
  exit 0
fi
zjr="$HOME/.local/bin/zj-radar"
if [ ! -x "$zjr" ]; then
  curl --proto '=https' --tlsv1.2 -LsSf \
    https://github.com/marktoda/zj-radar/releases/latest/download/install.sh | sh
fi
"$zjr" setup zellij --download -y
# producer per la sidebar: senza il plugin Claude la rail resta vuota
command -v claude >/dev/null 2>&1 && "$zjr" setup claude -y
# setup riscrive l'alias gestito e perde le opzioni: rimetti quelle di config.kdl.tmpl.
# Lo fa anche `zj-radar update`: poi basta `chezmoi apply`.
sed -i '/managed plugin alias begin/,/managed plugin alias end/{/glyphs "nerd"/d; /spinner_fps 6/d; s/^\( *\)naming "managed"$/&\n\1glyphs "nerd"\n\1spinner_fps 6/}' \
  "$HOME/.config/zellij/config.kdl"
{{- end }}
