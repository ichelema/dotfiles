{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Installa la sidebar zj-radar di zellij (v0.13.0, fork ichelema/zj-radar): wasm, alias e permessi.
# run_once: gira una volta per macchina e di nuovo quando questo file cambia.
# CLI e wasm sono già in chezmoi; alias e layout nei template: qui serve il grant dei permessi.
# Gli agenti non si configurano più: Zellij 0.46 legge OSC 7501 da solo (niente `setup claude`).
set -euo pipefail
if ! command -v zellij >/dev/null 2>&1; then
  echo "SALTATO: zellij non trovato, installalo e rilancia chezmoi apply" >&2
  exit 0
fi
zjr="$HOME/.local/bin/zj-radar"
if [ ! -x "$zjr" ]; then
  curl --proto '=https' --tlsv1.2 -LsSf \
    https://github.com/ichelema/zj-radar/releases/latest/download/install.sh | sh
fi
# setup riscrive l'alias gestito e perde le opzioni di config.kdl.tmpl: salva e rimetti il file.
# Lo fa anche `zj-radar update`: poi basta `chezmoi apply`.
cfg="$HOME/.config/zellij/config.kdl"
tmp="$(mktemp)"
cp -p "$cfg" "$tmp"
"$zjr" setup zellij --download -y
cp -p "$tmp" "$cfg"
rm -f "$tmp"
{{- end }}
