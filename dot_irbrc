# show_doc (RDoc::RI::Driver) tenta sempre un pager esterno, a differenza del
# pager di IRB. Su questo setup (WezTerm + MSYS pty) qualunque sottoprocessο
# che scrive molto output subito prima che Reline riprenda l'input causa un
# blocco del prompt (race fra il drain asincrono di ConPTY e la query di
# stato del terminale di Reline) — confermato con less, bat, less nativo e
# persino cat con output lungo. Forziamo l'output diretto su $stdout.
require 'rdoc/ri/driver'
class RDoc::RI::Driver
  def setup_pager
    @use_stdout = true
    nil
  end
end

# load .irbrc_rails in rails environments
railsrc_path = (File.expand_path("#{ENV['HOME']}/.irbrc_rails"))

