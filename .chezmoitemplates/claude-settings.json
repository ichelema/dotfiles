{
  "cleanupPeriodDays": 60,
  "syncClaudeAiSkills": false,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "API_TIMEOUT_MS": "300000",
    "MCP_TIMEOUT": "60000",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods",
{{- if eq .chezmoi.os "windows" }}
    "CLAUDE_CODE_AUTO_MODE_SERVER": "0",
    "CLAUDE_CODE_GIT_BASH_PATH": "e:\\msys64\\usr\\bin\\bash.exe",
    "MSYSTEM": "UCRT64",
    "CHERE_INVOKING": "1",
    "MSYS2_PATH_TYPE": "strict",
    "HOME": "e:\\msys64\\home\\sphynx",
    "OBSIDIAN_VAULT": "e:/obsidian/sinapsi",
    "OBSIDIAN_VAULT_NAME": "sinapsi",
    "NOTEBOOKLM_DATA": "e:/ai/tools/notebooklm-data",
    "NOTEBOOKLM_LIB": "e:/ai/tools/notebooklm",
    "MCP_EXCALIDRAW_DIR": "e:/msys64/home/sphynx/.local/opt/mcp_excalidraw",
    "MCP_DEBUGGER_DIR": "e:/ai/tools/mcp-debugger",
    "MCP_NEOVIM_DIR": "e:/ai/tools/mcp-neovim-server",
    "EDITOR": "e:\\msys64\\home\\Sphynx\\.local\\bin\\vim-claude.cmd",
    "CLAUDE_ENV_FILE": "e:/msys64/home/sphynx/.local/bin/claude-msys2-env.sh",
    "TRINITY_PLUGIN_DIR": "E:/AI/Claude/Trinity"
{{- else }}
    "EDITOR": "nvim",
    "SUDO_ASKPASS": "/home/ichelema/.local/bin/sudo-askpass.sh",
    "OBSIDIAN_VAULT": "/Dati/Obsidian/Sinapsi",
    "OBSIDIAN_VAULT_NAME": "sinapsi",
    "MCP_EXCALIDRAW_DIR": "/home/ichelema/.local/opt/mcp_excalidraw",
    "MCP_DEBUGGER_DIR": "/Dati/AI/tools/mcp-debugger",
    "MCP_NEOVIM_DIR": "/Dati/AI/tools/mcp-neovim-server",
    "NVIM_SOCKET_PATH": "/run/user/{{ .chezmoi.uid }}/claude-debug-Trinity",
    "NOTEBOOKLM_DATA": "/Dati/AI/tools/notebooklm-data",
    "NOTEBOOKLM_LIB": "/home/ichelema/.local/share/mise/installs/python/3.13/lib/python3.13/site-packages",
    "PLAYWRIGHT_MCP_BROWSER": "chromium",
    "TRINITY_PLUGIN_DIR": "/Dati/AI/Claude/Trinity"
{{- end }}
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(pnpm *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(python *)",
      "Bash(ruby *)",
      "Bash(ls*)",
      "Bash(sleep *)",
      "Bash(echo *)",
      "Read",
      "mcp__excalidraw__export_scene",
      "mcp__excalidraw__read_diagram_guide",
      "mcp__excalidraw__clear_canvas",
      "mcp__excalidraw__batch_create_elements",
      "mcp__excalidraw__set_viewport",
      "mcp__excalidraw__get_canvas_screenshot",
      "mcp__excalidraw__update_element",
      "mcp__excalidraw__create_from_mermaid",
      "mcp__excalidraw__query_elements",
      "mcp__excalidraw__delete_element",
      "mcp__excalidraw__describe_scene",
      "Edit(/e/obsidian/sinapsi/**)",
      "Bash(start obsidian://adv-uri?vault=* *)",
      "Skill(double-commander-docs)",
      "mcp__obsidian_semantic_notes_vault__vault",
      "mcp__obsidian_semantic_notes_vault__view",
      "mcp__obsidian_semantic_notes_vault__graph",
      "Read(//tmp/**)",
      "Bash(shasum -a 256)",
      "mcp__hindsight__recall",
      "mcp__hindsight__get_bank",
      "mcp__hindsight__list_tags",
      "mcp__hindsight__list_memories"
    ],
    "deny": [
      {{- if eq .chezmoi.os "windows" }}
      "Bash(rm */c/*)",
      "Bash(rm *C:/*)",
      "Bash(rm *c:/*)",
      "Bash(rm *C:\\*)",
      "Bash(rm *c:\\*)",
      {{- end }}
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/infomaniak_vps)",
      "Edit(~/.ssh/infomaniak_vps)",
      "Read(~/.ssh/id_*)",
      "Edit(~/.ssh/id_*)",
      "Read(~/.ssh/*.pem)",
      "Edit(~/.ssh/*.pem)"
    ],
    "ask": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)"
    ],
    "defaultMode": "auto"
  },
  "model": {{ if eq .chezmoi.os "linux" }}"opus"{{ else }}"opus[1m]"{{ end }},
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "simplify": "off",
    "dataviz": "off",
    "claude-in-chrome": "off"
  },
  "disableBundledSkills": true,
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "printf '%s' \"${CLAUDE_STATUSLINE:-Claude}\"",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "prismantis@inline": true,
    "skins@inline": false,
    "replay@inline": false
  },
  "extraKnownMarketplaces": {},
  "outputStyle": "simple",
  "language": "italiano",
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "showThinkingSummaries": false,
  "skipDangerousModePermissionPrompt": false,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:nord",
  "editorMode": "vim",
  "verbose": false,
  "switchModelsOnFlag": true,
  "fileCheckpointingEnabled": true,
  "terminalProgressBarEnabled": true,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": true,
  "pluginConfigs": {
    "prismantis@inline": { "options": { "theme": "nord", "tableStyle": "box", "toolStyle": "folded", "toolRows": true, "promptStyle": "framed", "headingStyle": "banner" } },
    "jev-skill-suggestion@inline": { "options": { "logDecisions": true } }{{ with env "TYPESAFE_API_KEY" }},
    "jev-skill-suggestion": { "options": {
      "typesafeApiKey": {{ . | toJson }},
      "provider": "typesafe",
      "timeoutMs": 1500,
      "gateThreshold": 0.5,
      "inject": "suggest",
      "neverSuggested": "trinity:dream,trinity:linear,trinity:nota_del_giorno,trinity:promote,trinity:reflect,trinity:ponytail,trinity:ponytail:ponytail,trinity:ponytail:ponytail-audit,trinity:ponytail:ponytail-debt,trinity:ponytail:ponytail-gain,trinity:ponytail:ponytail-help,trinity:ponytail:ponytail-review,trinity:workflow:0_create-issue,trinity:workflow:1_create-worktree,trinity:workflow:2_work-issue,trinity:workflow:3_independent-review,trinity:workflow:4_remove-worktree,trinity:workflow:5_review-fix-loop"
    } }{{ end }}
  }
}
