# Tempo di risposta più rapido per ESC
export KEYTIMEOUT=40

# Funzione per cambiare la forma del cursore in base alla modalità
function zle-keymap-select {
  case $KEYMAP in
    vicmd)      # quando si è in modalità comando (normale)
      echo -ne '\e[1 q'  # cursore a blocco
      ;;
    viins|main) # quando si è in modalità inserimento
      echo -ne '\e[5 q'  # cursore a barra verticale
      ;;
  esac
}
zle -N zle-keymap-select

# Assicurati che il cursore sia giusto all'inizio della riga
function zle-line-init {
  echo -ne '\e[5 q'  # inizia sempre in modalità inserimento
}
zle -N zle-line-init

# Reimposta il cursore quando si esegue un comando
function zle-line-finish {
  echo -ne '\e[5 q'  # torna al cursore modalità inserimento
}
zle -N zle-line-finish

# Prompt: Starship. Va DOPO i widget zle: così wrappa il tuo zle-keymap-select e il prompt si ridisegna in modalità vi.
if command -v starship >/dev/null 2>&1; then
  export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
  eval "$(starship init zsh)"
fi

# Inizializza il cursore corretto all'avvio
echo -ne '\e[5 q'

