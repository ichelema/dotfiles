# Add event hook
autoload -Uz add-zsh-hook
# Information in repository (git, svn, hg, etc.)
autoload -Uz vcs_info
# precmd hook lo load vcs_info
precmd () { vcs_info }

zstyle ':vcs_info:*' formats ' %B%s-[%F{magenta}%f %F{yellow}%b%f]-'

#  ╔╗ ╦╔╗╔╔╦╗╦╔╗╔╔═╗
#  ╠╩╗║║║║ ║║║║║║║ ╦
