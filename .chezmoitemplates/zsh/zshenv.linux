#!/usr/bin/env zsh
#!          ░▒▓
#!        ░▒▒░▓▓
#!      ░▒▒▒░░░▓▓           ___________
#!    ░░▒▒▒░░░░░▓▓        //___________/
#!   ░░▒▒▒░░░░░▓▓     _   _ _    _ _____
#!   ░░▒▒░░░░░▓▓▓▓▓▓ | | | | |  | |  __/
#!    ░▒▒░░░░▓▓   ▓▓ | |_| | |_/ /| |___
#!     ░▒▒░░▓▓   ▓▓   \__  |____/ |____/    ▀█ █▀ █░█
#!       ░▒▓▓   ▓▓  //____/                █▄ ▄█ █▀█



# cleaning up home folder
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_CONFIG_DIR="${XDG_CONFIG_DIR:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_DATA_DIRS="${XDG_DATA_DIRS:-$XDG_DATA_HOME:/usr/local/share:/usr/share}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
# XDG user directories: fonte unica di verita' = ~/.config/user-dirs.dirs
# (lo stesso file letto dalle app GUI via GLib). set -a esporta tutto cio' che
# viene assegnato qui dentro. Se il file c'e' i suoi valori vincono; i ':=' sotto
# sono solo una rete di sicurezza (default standard XDG) per quando il file manca.
set -a
[ -r "$XDG_CONFIG_HOME/user-dirs.dirs" ] && . "$XDG_CONFIG_HOME/user-dirs.dirs"
: "${XDG_DESKTOP_DIR:=$HOME/Scrivania}"
: "${XDG_DOWNLOAD_DIR:=$HOME/Scaricati}"
: "${XDG_TEMPLATES_DIR:=$HOME/Modelli}"
: "${XDG_PUBLICSHARE_DIR:=$HOME/Pubblici}"
: "${XDG_DOCUMENTS_DIR:=$HOME/Documenti}"
: "${XDG_MUSIC_DIR:=$HOME/Musica}"
: "${XDG_PICTURES_DIR:=$HOME/Immagini}"
: "${XDG_VIDEOS_DIR:=$HOME/Video}"
set +a
LESSHISTFILE=${LESSHISTFILE:-/tmp/less-hist}
# less: icone Nerd Font (Unicode uso privato) stampabili, non <U+E5FF>
export LESSUTFCHARDEF='E000-F8FF:p,F0000-FFFFD:p,100000-10FFFD:p'
# less: colori (-R) e ricerca che ignora sempre maiuscole e minuscole (-I); oh-my-zsh non la sovrascrive
export LESS='-R -I'
PARALLEL_HOME="$XDG_CONFIG_HOME/parallel"

# wget
WGETRC="${XDG_CONFIG_HOME}/wgetrc"
SCREENRC="$XDG_CONFIG_HOME"/screen/screenrc
PARALLEL_HOME="$XDG_CONFIG_HOME/parallel"
ZSH_AUTOSUGGEST_STRATEGY=(history)

# locale anche nelle shell non di login (ssh host comando): /etc/locale.conf vale solo
# per il login, e senza LANG zsh e Zellij nati da un comando ssh mostrano "?????"
: "${LANG:=it_IT.UTF-8}"; export LANG

export ZDOTDIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"

export XDG_CONFIG_HOME XDG_CONFIG_DIR XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME WGETRC SCREENRC

{{ if index . "vps" -}}
# mosh: chiude mosh-server dopo 7 giorni senza contatti dal client (sessioni orfane)
# solo sulla VPS, dove gira mosh-server
export MOSH_SERVER_NETWORK_TMOUT=604800

{{ end -}}

# API key AI/LLM: file a parte, gestito cifrato da chezmoi
[ -r "$ZDOTDIR/api-keys.zsh" ] && source "$ZDOTDIR/api-keys.zsh"
