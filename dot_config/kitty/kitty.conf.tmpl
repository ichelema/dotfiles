# This is the configuration file for kitty terminal
# For more information, see https://sw.kovidgoyal.net/kitty/conf.html
# For your custom configurations, put it in ./kitty.conf
font_family FiraCode Nerd Font Mono
font_features +cv02 +cv05 +cv09 +cv14 +ss04 +cv16 +cv31 +cv25 +cv26 +cv32 +cv28 +ss10 +zero +onum
bold_font auto
italic_font auto
disable_ligatures never
bold_italic_font auto
enable_audio_bell no
font_size 10.0
window_padding_width 5
cursor_trail 0
adjust_line_height 110%

{{ if not (index . "vps") -}}
# Themes can override any settings in this file
# Tema di Hyprland: esiste solo sul Linux principale, non sulla VPS
include ~/.config/hypr/themes/current/theme/Applications/kitty.conf
{{ end -}}
#background_opacity 0.60
#hide_window_decorations yes
#confirm_os_window_close 0
include userprefs.conf
# Add your custom configurations here
