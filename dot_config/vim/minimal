            let s:under = "\e[4 q"   " underscore        (hor20)
            let s:block = "\e[2 q"   " blocco pieno

            " Insert / Replace / Normal
            let &t_SI = s:bar
            let &t_SR = s:under
            let &t_EI = s:block
