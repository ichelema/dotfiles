        " file da ignorare nel wildmenu
        set wildignore=*.o,*~,*.pyc,*.png,*.jpg,*.gif,*.xlsm,*.xls,*.xlsx,*.zip,*.so,*.exe,*.ico,*.lock,*.tags,*tags
        set wildignore+=log/**
        set wildignore+=*\\log\\*
