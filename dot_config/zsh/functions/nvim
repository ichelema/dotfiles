emulate -L zsh

# Lancia il Neovim NATIVO Windows ripulendo le var d'ambiente MSYS
# (HOME/XDG/SHELL) cosi' che usi la sua config Windows (~/AppData/Local/nvim)
# invece di ereditare quella di MSYS2. Path assoluto = niente ricorsione.
local nvim_win="/c/Appl/Neovim/bin/nvim.exe"

# Antepone git-for-windows al PATH: senza, nvim userebbe il git MSYS, che
# restituisce path in formato MSYS (/d/AI/...) -> nvim li legge come \d\AI\...
# e l'fs watcher fallisce con ENOENT (nvim-tree, gitsigns, fugitive).
local git_win="/c/Appl/cmder/vendor/git-for-windows/cmd"

# Subshell + exec al posto di env: stesso ambiente per nvim, un processo in meno
# (su questo PC env costa ~65 ms a ogni avvio).
(
  unset XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME \
    XDG_RUNTIME_DIR XDG_CONFIG_DIRS XDG_DATA_DIRS HOME SHELL PWD OLDPWD
  export PATH="$git_win:$PATH"
  exec "$nvim_win" "$@"
)
