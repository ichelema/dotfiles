local file

file="$(
  fd . . \
    --type f \
    --hidden \
    --exclude .git \
    --exclude .cache \
    --exclude node_modules \
    --exclude dist \
    --exclude build \
    --exclude .venv \
    --exclude __pycache__ \
    --exclude .next \
    --exclude .turbo |
  fzf \
    --height=80% \
    --reverse \
    --preview 'bat --style=numbers --color=always --line-range :160 {} 2>/dev/null'
)"

[[ -z "$file" ]] && return

vim "$file"
