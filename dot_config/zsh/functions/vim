emulate -L zsh

# Lancia il Vim NATIVO Windows ripulendo PWD/SHELL (var MSYS). HOME resta quello
# MSYS (D:\msys64\home\Sphynx): senza HOME Vim usa HOMEDRIVE (V:\) e non trova
# vimfiles (junction verso ~/.config/vim). -u SHELL fa usare cmd.exe (default)
# invece di bash/zsh: fzf.vim richiede cmd.exe per convertire i path.
# --not-a-term: sopprime "Vim: Warning: Output is not to a terminal" e i 2s
# di attesa all'avvio quando vim.exe nativo gira da terminale MSYS2.
local vim_win="/c/Appl/Vim/vim.exe"

# Subshell + exec al posto di env: stesso ambiente per Vim, un processo in meno
# (su questo PC env costa ~65 ms a ogni avvio).
(
  unset PWD OLDPWD SHELL
  exec "$vim_win" --not-a-term "$@"
)
