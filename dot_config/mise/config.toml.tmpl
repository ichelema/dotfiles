{{- end }}
{{- end }}

# Entrando in un repository Git: fetch (max 5 s, al più uno al minuto), così il prompt p10k mostra ⇣ e ⇡ aggiornati.
[hooks]
cd = { shell = "bash -c", run = '''
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0
[ -z "$(find "$(git rev-parse --git-dir)/FETCH_HEAD" -mmin -1 2>/dev/null)" ] && GIT_TERMINAL_PROMPT=0 timeout 5 git fetch --quiet >/dev/null 2>&1
exit 0
''' }
